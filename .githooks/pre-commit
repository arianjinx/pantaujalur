#!/bin/sh
cd "$(git rev-parse --show-toplevel)" || exit 1
list=$(mktemp) || exit 1
trap 'rm -f "$list"' EXIT
# Skip symlinks such as .claude/skills: the formatter would follow them.
# bash, not the dash shell this hook runs under, because read -d is bash.
git diff --cached --name-only -z --diff-filter=ACMR | bash -c 'while IFS= read -r -d "" f; do [ -L "$f" ] || printf "%s\0" "$f"; done' >"$list"
[ -s "$list" ] || exit 0
partly=$(xargs -0 git diff --name-only -- <"$list")
if [ -n "$partly" ]; then
  printf 'pre-commit: these files are partly staged, and formatting re-stages whole files. Stage or stash the rest first:\n%s\n' "$partly" >&2
  exit 1
fi
{ xargs -0 bun run --silent lint:fix <"$list" >/dev/null 2>&1 || true; } &&
  xargs -0 bun fmt --no-script --ignore-unknown --log-level warn <"$list" &&
  xargs -0 git add -- <"$list"
